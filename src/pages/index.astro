---
import Base from '../layouts/Base.astro';
import { getColumns, formatDate } from '../lib';

const columns = (await getColumns()).slice(0, 4);
---
<Base>
<div class="ruler" aria-hidden="true">
  <div class="scale"></div>
  <span class="lab" style="top:0">0</span><span class="lab" style="top:33%">의뢰</span>
  <span class="lab" style="top:66%">AI</span><span class="lab" style="top:100%">칼럼</span>
  <span class="dot"></span>
</div>

  <section class="scene intro" id="intro" aria-labelledby="t1">
    <div class="wrap">
      <div class="intro-head reveal">
        <h1 id="t1">숫자를<br>제대로 <span class="nw">가늠하는 법</span></h1>
        <p class="lede">가늠은 작은 팀과 개인이 자기 데이터를 제대로 읽도록 돕습니다. 흩어진 신호를 좌표로 옮기고, 좌표를 분포로 쌓아 읽습니다.</p>
      </div>
      <div class="instrument" aria-label="레이더가 찾은 신호를 직교좌표와 분포로 옮기는 그림">
        <figure class="panel radar-panel">
          <div class="cv"><canvas id="radar" aria-hidden="true"></canvas></div>
        </figure>
        <figure class="panel">
          <div class="cv short"><canvas id="scatter" aria-hidden="true"></canvas></div>
        </figure>
        <figure class="panel">
          <div class="cv short"><canvas id="hist" aria-hidden="true"></canvas></div>
        </figure>
      </div>
    </div>
  </section>

  <section class="scene" id="request" aria-labelledby="t2">
    <div class="wrap grid">
      <div class="reveal">
        <p class="step">1</p>
        <h2 id="t2">자료만 보내 주세요.<br>가늠이 직접 분석합니다</h2>
        <p class="lede">엑셀·CSV 자료와 궁금한 점을 알려 주시면, 분석이 가능한지와 비용·일정을 먼저 안내해 드립니다. 결과는 계산 근거를 담은 보고서로 드립니다.</p>
        <div class="cta">
          <a class="btn accent" href="/request/">분석 의뢰<small>상담·견적 무료</small></a>
          <p class="note">카카오톡 1:1 오픈채팅으로 연결됩니다. 상담방에 들어오시는 것만으로는 결제되지 않습니다.</p>
        </div>
      </div>
      <div class="terms" aria-label="의뢰 조건">
        <div class="term"><span class="k">상담</span><div><div class="v">상담·견적 무료</div><div class="s">견적을 보고 진행 여부를 정하시면 됩니다.</div></div></div>
        <div class="term"><span class="k">비용</span><div><div class="v">1만 원부터</div><div class="s">가벼운 분석은 1만 원부터 시작합니다.</div></div></div>
        <div class="term"><span class="k">시작</span><div><div class="v">예약금 10%만 내고 시작</div><div class="s">잔금은 결과를 확인하신 뒤 정산합니다.</div></div></div>
      </div>
    </div>
  </section>

  <section class="scene" id="ai" aria-labelledby="t3">
    <div class="wrap grid">
      <div class="reveal">
        <p class="step">2</p>
        <h2 id="t3">파일을 올리고<br>질문하세요<span class="soon">준비중</span></h2>
        <p class="lede">엑셀·CSV를 올리면 AI가 표를 읽고 질문에 답합니다. 답마다 실행한 계산과 지표의 정의가 함께 붙어, 숫자가 어디서 나왔는지 확인할 수 있습니다.</p>
        <div class="cta">
          <span class="btn" role="link" aria-disabled="true">AI 분석 시작하기<small>준비중입니다</small></span>
          <p class="note">지금은 일부 계정으로만 시험 운영하고 있습니다. 열리면 이 버튼으로 바로 시작할 수 있습니다.</p>
        </div>
      </div>
      <div class="desk" aria-label="AI 분석 화면 예시">
        <span class="tag">화면 예시 · 가상 데이터</span>
        <div class="row">
          <div class="h">파일 올리기</div>
          <div class="file"><span class="ico">CSV</span><div><b>orders_sample.csv</b><div style="font-size:12.5px;color:var(--mute)">4,820행 · 7열 · 열 확인 완료</div></div></div>
        </div>
        <div class="row"><div class="q">월별 재구매율이 어떻게 바뀌었나요?</div></div>
        <div class="row">
          <div class="h">월별 재구매율 (%)</div>
          <div class="bars" aria-hidden="true">
            <div class="bar" style="height:52%"></div><div class="bar" style="height:58%"></div><div class="bar" style="height:55%"></div>
            <div class="bar" style="height:64%"></div><div class="bar" style="height:61%"></div><div class="bar hi" style="height:46%"></div>
          </div>
          <div class="axis" aria-hidden="true"><span>5월</span><span>6월</span><span>7월</span><span>8월</span><span>9월</span><span>10월</span></div>
          <div class="sqlline"><b>SELECT</b> month, repeat_rate <b>FROM</b> orders <b>GROUP BY</b> 1</div>
        </div>
      </div>
    </div>
  </section>

  <section class="scene" id="columns" aria-labelledby="t4">
    <div class="wrap grid">
      <div class="reveal">
        <p class="step">3</p>
        <h2 id="t4">숫자를 읽는 법을<br>칼럼으로 씁니다</h2>
        <p class="lede">리텐션, 퍼널, AB 테스트처럼 작은 팀이 자주 마주치는 분석을 계산 과정과 함께 풀어 씁니다.</p>
        <div class="cta">
          <a class="btn ink" href="/columns/">분석 칼럼 읽기</a>
        </div>
      </div>
      <div class="stack" aria-label="최근 칼럼">
        {columns.map((c) => (
          <a class="sheet" href={`/columns/${c.id}/`}><div class="d"><span>{c.data.tags[0] ?? '칼럼'}</span><span>{formatDate(c.data.date)}</span></div><h3>{c.data.title}</h3></a>
        ))}
      </div>
    </div>
  </section>

</Base>

<style is:global>
/* 홈(대문) 전용 — 사이트 토큰(global.css)을 이 페이지의 이름으로 잇는다. 스크롤 대문 시안(2026-11-01) */
:root{
  --paper:var(--bg); --sheet:var(--surface); --ink:var(--text); --mute:var(--muted); --line:var(--rule); --accent-ink:var(--on-accent);
  --accent-soft:#efe1da; --off:#b9b4aa;
  --serif-l:"Noto Serif KR","Nanum Myeongjo",Georgia,serif;
}
@media (prefers-color-scheme: dark){ :root:not([data-theme="light"]){ --accent-soft:#2c1f1a; --off:#5d5a54 } }
:root[data-theme="dark"]{ --accent-soft:#2c1f1a; --off:#5d5a54 }
html{scroll-behavior:smooth}
h1,h2,h3{text-wrap:balance;font-family:var(--serif-l);font-synthesis:none;margin:0}
p{text-wrap:pretty;margin:0}
:focus-visible{outline:2px solid var(--accent);outline-offset:3px}

.wrap{max-width:1120px;margin:0 auto;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
@media(min-width:900px){.wrap{padding-left:max(56px,env(safe-area-inset-left,0px));padding-right:max(96px,env(safe-area-inset-right,0px))}}


/* 장면 공통 */
.scene{min-height:88vh;display:flex;align-items:center;padding-block:72px;border-bottom:1px solid var(--hair)}
.scene .wrap{width:100%}
.grid{display:grid;gap:40px;align-items:center}
@media(min-width:900px){.grid{grid-template-columns:minmax(0,1.05fr) minmax(0,1fr);gap:64px}}
.grid>*{min-width:0}
.step{font-size:13px;font-weight:700;color:var(--accent);margin-bottom:14px;font-variant-numeric:tabular-nums}
.scene h2{font-size:clamp(34px,5.4vw,60px);line-height:1.15;letter-spacing:-.03em;font-weight:700}
.lede{font-size:clamp(17px,1.8vw,19px);color:var(--mute);margin-top:18px;max-width:34em}

.btn{display:inline-flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:2px;min-height:64px;min-width:min(320px,100%);
  padding:10px 30px;border-radius:14px;font:inherit;font-weight:700;font-size:18px;line-height:1.25;text-decoration:none;border:1.5px solid var(--line);
  background:transparent;color:var(--ink);cursor:pointer;transition:transform .2s ease,background .2s ease}
.btn small{font-weight:400;font-size:12.5px;opacity:.85}
.btn:hover{transform:translateY(-2px)}
.btn.accent{background:var(--accent);border-color:var(--accent);color:var(--accent-ink)}
.btn.ink{background:var(--ink);border-color:var(--ink);color:var(--paper)}
.btn[aria-disabled="true"]{cursor:not-allowed;background:var(--sheet);border-style:dashed;border-color:var(--off);color:var(--mute);transform:none}
.cta{margin-top:32px;display:flex;flex-wrap:wrap;align-items:center;gap:14px 18px}
.cta .note{font-size:13.5px;color:var(--mute);max-width:24em}
@media(max-width:520px){.btn{width:100%}}

/* 1. 소개: 레이더 → 직교좌표 → 분포 */
.intro{align-items:flex-start}
.intro h1{font-size:clamp(44px,8vw,96px);line-height:1.04;letter-spacing:-.04em;font-weight:400}
.intro h1 .nw{white-space:nowrap}
.intro .lede{color:var(--ink);font-family:var(--serif-l);font-size:clamp(18px,2vw,21px)}
.intro-head{max-width:760px}
.instrument{display:grid;gap:10px;margin-top:32px;grid-template-columns:minmax(0,1.25fr) minmax(0,1fr);grid-template-rows:auto auto;align-items:center}
.radar-panel{grid-row:1 / span 2}
@media(min-width:900px){.instrument{gap:14px;margin-top:40px}}
.panel{margin:0;background:transparent;border:0;padding:0;display:flex;flex-direction:column;min-width:0}
.panel figcaption{display:flex;flex-wrap:wrap;justify-content:space-between;gap:4px 12px;font-size:12.5px;color:var(--mute)}
.panel figcaption span:first-child{color:var(--ink);font-weight:700}
.panel .eq{font-family:ui-monospace,Consolas,monospace;font-size:12px}
.cv{position:relative;width:100%;aspect-ratio:1/1;max-width:100%}
.cv.short{aspect-ratio:16/9}
.radar-panel .cv{flex:1}
.cv canvas{position:absolute;inset:0;width:100%;height:100%;display:block}
.readout{font-family:ui-monospace,Consolas,monospace;font-size:12px;color:var(--mute);font-variant-numeric:tabular-nums;min-height:1.6em}

/* 2. 분석 의뢰: 조건 세 줄 */
.terms{display:grid;gap:0;border-top:2px solid var(--line)}
.term{display:grid;grid-template-columns:72px minmax(0,1fr);gap:16px;padding:20px 0;border-bottom:1px solid var(--hair)}
.term .k{font-size:13px;color:var(--mute);padding-top:6px}
.term .v{font-family:var(--serif-l);font-weight:700;font-size:clamp(22px,2.6vw,30px);line-height:1.3}
.term .s{font-size:14.5px;color:var(--mute);margin-top:2px}
.free{display:inline-block;background:var(--accent-soft);color:var(--accent);border-radius:6px;padding:0 8px;font-size:.62em;vertical-align:.25em;margin-left:6px;font-family:var(--sans)}

/* 3. AI 분석: 작업 화면 예시 */
.desk{background:var(--sheet);border:1px solid var(--line);border-radius:18px;padding:18px;display:grid;gap:12px;box-shadow:8px 8px 0 var(--hair)}
.desk .tag{justify-self:start;font-size:11.5px;color:var(--mute);border:1px solid var(--hair);border-radius:999px;padding:1px 10px}
.row{border:1px solid var(--hair);border-radius:12px;padding:12px 14px;background:var(--paper)}
.row .h{font-size:12px;color:var(--mute);margin-bottom:6px}
.file{display:flex;align-items:center;gap:12px;font-size:14px}
.file b{font-weight:500;font-family:ui-monospace,Consolas,monospace}
.file .ico{flex:none;width:30px;height:36px;border:1.5px solid var(--off);border-radius:3px 9px 3px 3px;display:grid;place-items:end center;font-size:9px;font-weight:700;padding-bottom:3px}
.q{font-size:15px}
.q::before{content:"질문";font-size:11px;font-weight:700;color:var(--accent);background:var(--accent-soft);border-radius:4px;padding:1px 6px;margin-right:8px}
.bars{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));align-items:end;gap:8px;height:120px;padding-top:6px}
.bar{background:var(--ink);opacity:.82;border-radius:3px 3px 0 0;transform-origin:bottom}
.bar.hi{background:var(--accent);opacity:1}
.axis{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:8px;font-size:11px;color:var(--mute);text-align:center;font-variant-numeric:tabular-nums;margin-top:4px}
.sqlline{font-family:ui-monospace,Consolas,monospace;font-size:12px;color:var(--mute);margin-top:8px}
.sqlline b{color:var(--ink);font-weight:600}
.soon{display:inline-block;font-size:12px;font-weight:700;border:1px solid var(--accent);color:var(--accent);border-radius:6px;padding:0 8px;margin-left:8px;vertical-align:.3em;font-family:var(--sans)}

/* 4. 칼럼: 원고 더미 */
.stack{display:grid;gap:12px}
.sheet{display:block;text-decoration:none;background:var(--sheet);border:1px solid var(--line);padding:18px 20px;border-radius:4px}
.sheet:nth-child(2){margin-left:4%}.sheet:nth-child(3){margin-left:8%}.sheet:nth-child(4){margin-left:12%}
@media(max-width:520px){.sheet:nth-child(n){margin-left:0}}
.sheet .d{font-size:12.5px;color:var(--mute);font-variant-numeric:tabular-nums;display:flex;justify-content:space-between;gap:12px}
.sheet h3{font-size:clamp(17px,1.9vw,20px);line-height:1.4;margin-top:4px}
.sheet:hover h3{text-decoration:underline;text-underline-offset:4px}

/* 오른쪽 가늠자: 스크롤 위치 0~100 */
.ruler{display:none}
@media(min-width:900px){
  .ruler{display:block;position:fixed;right:max(24px,env(safe-area-inset-right,0px));top:calc(76px + 9vh);bottom:9vh;width:40px;z-index:4;pointer-events:none}
  .ruler .scale{position:absolute;inset:0 auto 0 0;width:12px;border-right:1.5px solid var(--line);
    background:repeating-linear-gradient(to bottom,var(--line) 0 1px,transparent 1px 10%)}
  .ruler .lab{position:absolute;left:18px;font-size:11px;color:var(--mute);font-variant-numeric:tabular-nums;transform:translateY(-50%)}
  .ruler .dot{position:absolute;left:4px;top:0;width:16px;height:16px;margin-top:-8px;border-radius:50%;background:var(--accent);border:3px solid var(--paper)}
}

/* 스크롤 연동 움직임 — 지원하는 브라우저에서만. 멈춘 상태(지원 안 함·움직임 줄이기)는 위의 기본값 그대로 다 보인다 */
@supports (animation-timeline: view()){
  @media (prefers-reduced-motion: no-preference){
    @keyframes rise{from{transform:translateY(36px);opacity:.25}to{transform:none;opacity:1}}
    @keyframes grow{from{transform:scaleY(.12)}to{transform:scaleY(1)}}
    @keyframes slide{from{transform:translateX(-28px);opacity:.3}to{transform:none;opacity:1}}
    @keyframes travel{from{top:0}to{top:100%}}
    .reveal{animation:rise linear both;animation-timeline:view();animation-range:entry 0% cover 35%}
    .bar{animation:grow linear both;animation-timeline:view();animation-range:entry 10% cover 45%}
    .term{animation:slide linear both;animation-timeline:view();animation-range:entry 0% cover 30%}
    .sheet{animation:slide linear both;animation-timeline:view();animation-range:entry 0% cover 30%}
    .ruler .dot{animation:travel linear both;animation-timeline:scroll(root)}
  }
}

</style>

<script is:inline>

(() => {
  const TAU = Math.PI * 2;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const css = n => getComputedStyle(document.documentElement).getPropertyValue(n).trim();
  let C = {};
  const readTheme = () => { C = { ink: css('--ink'), mute: css('--mute'), accent: css('--accent') }; };
  readTheme();
  const mq = matchMedia('(prefers-color-scheme: dark)');
  if (mq.addEventListener) mq.addEventListener('change', () => { readTheme(); draw(); });

  // 시드 난수 + 정규분포(Box-Muller). 점 위치는 무작위, 분포의 기준 σ 는 고정
  let seed = 20261101 >>> 0;
  const rnd = () => { seed = (seed + 0x6d2b79f5) >>> 0; let t = seed; t = Math.imul(t ^ (t >>> 15), t | 1); t ^= t + Math.imul(t ^ (t >>> 7), t | 61); return ((t ^ (t >>> 14)) >>> 0) / 4294967296; };
  const SIGMA = 0.34;
  const gauss = () => Math.sqrt(-2 * Math.log(1 - rnd())) * Math.cos(TAU * rnd());
  const randomPoint = () => { for (;;) { const x = gauss() * SIGMA, y = gauss() * SIGMA; if (x * x + y * y < 0.9) return { x, y }; } };

  const TARGETS = 7, RECENT = 30, BINS = 17, LO = -1.2, HI = 1.2;
  const targets = Array.from({ length: TARGETS }, () => ({ ...randomPoint(), seen: -99, px: 0, py: 0 }));
  const recent = [], bins = new Array(BINS).fill(0);
  let n = 0, sum = 0, sum2 = 0;
  const record = p => {
    recent.push({ x: p.x, y: p.y }); if (recent.length > RECENT) recent.shift();
    const u = (p.x + p.y) / Math.SQRT2; n++; sum += u; sum2 += u * u;
    const i = Math.floor((u - LO) / (HI - LO) * BINS); if (i >= 0 && i < BINS) bins[i]++;
    return u;
  };
  // 첫 화면부터 산점도와 분포가 보이도록 미리 쌓아 둔다
  for (let i = 0; i < 160; i++) record(randomPoint());

  const setup = id => { const c = document.getElementById(id); return { c, g: c.getContext('2d'), w: 0, h: 0 }; };
  const R = setup('radar'), S = setup('scatter'), H = setup('hist');
  const fit = v => { const r = v.c.getBoundingClientRect(), d = Math.min(devicePixelRatio || 1, 2); v.w = r.width; v.h = r.height; v.c.width = Math.max(1, Math.round(r.width * d)); v.c.height = Math.max(1, Math.round(r.height * d)); v.g.setTransform(d, 0, 0, d, 0, 0); };

  let sweep = 0, time = 0, pings = [], lastU = null;

  function drawRadar() {
    const { g, w, h } = R; g.clearRect(0, 0, w, h);
    const cx = w / 2, cy = h / 2, rad = Math.min(w, h) * 0.46;
    const start = sweep - Math.PI / 2 - 1.5, endA = sweep - Math.PI / 2;
    if (g.createConicGradient) {
      const cg = g.createConicGradient(start, cx, cy);
      cg.addColorStop(0, 'rgba(0,0,0,0)'); cg.addColorStop(1.5 / TAU, C.accent);
      g.save(); g.globalAlpha = 0.18; g.beginPath(); g.moveTo(cx, cy); g.arc(cx, cy, rad, start, endA); g.closePath(); g.fillStyle = cg; g.fill(); g.restore();
    }
    g.strokeStyle = C.ink; g.lineWidth = 1;
    for (let k = 1; k <= 5; k++) { g.globalAlpha = k === 5 ? 0.9 : 0.16; g.beginPath(); g.arc(cx, cy, rad * k / 5, 0, TAU); g.stroke(); }
    g.globalAlpha = 0.1;
    for (let k = 0; k < 12; k++) { const a = k / 12 * TAU; g.beginPath(); g.moveTo(cx, cy); g.lineTo(cx + Math.sin(a) * rad, cy - Math.cos(a) * rad); g.stroke(); }
    for (let k = 0; k < 72; k++) {
      const a = k / 72 * TAU, L = k % 6 === 0 ? 9 : 4; g.globalAlpha = k % 6 === 0 ? 0.7 : 0.3;
      g.beginPath(); g.moveTo(cx + Math.sin(a) * rad, cy - Math.cos(a) * rad); g.lineTo(cx + Math.sin(a) * (rad + L), cy - Math.cos(a) * (rad + L)); g.stroke();
    }
    g.globalAlpha = 1; g.strokeStyle = C.accent; g.lineWidth = 2;
    g.beginPath(); g.moveTo(cx, cy); g.lineTo(cx + Math.sin(sweep) * rad, cy - Math.cos(sweep) * rad); g.stroke();
    targets.forEach(t => {
      const age = time - t.seen; if (age > 5) return;
      g.globalAlpha = Math.max(0, 1 - age / 5); g.fillStyle = C.accent;
      g.beginPath(); g.arc(cx + t.px * rad, cy - t.py * rad, 4, 0, TAU); g.fill();
    });
    pings = pings.filter(p => time - p.t < 1.2);
    pings.forEach(p => {
      const k = (time - p.t) / 1.2; g.globalAlpha = (1 - k) * 0.8; g.strokeStyle = C.accent; g.lineWidth = 1.5;
      g.beginPath(); g.arc(cx + p.x * rad, cy - p.y * rad, 4 + 22 * (1 - Math.pow(1 - k, 3)), 0, TAU); g.stroke();
    });
    g.globalAlpha = 1; g.fillStyle = C.ink; g.beginPath(); g.arc(cx, cy, 3.5, 0, TAU); g.fill();
  }

  function drawScatter() {
    const { g, w, h } = S; g.clearRect(0, 0, w, h);
    const side = Math.min(w - 12, h - 12), ox = (w - side) / 2, oy = (h - side) / 2;
    const X = v => ox + (v + 1) / 2 * side, Y = v => oy + (1 - (v + 1) / 2) * side;
    g.strokeStyle = C.ink; g.lineWidth = 1;
    g.globalAlpha = 0.14;
    for (let k = -1; k <= 1.001; k += 0.5) {
      g.beginPath(); g.moveTo(X(k), Y(-1)); g.lineTo(X(k), Y(1)); g.stroke();
      g.beginPath(); g.moveTo(X(-1), Y(k)); g.lineTo(X(1), Y(k)); g.stroke();
    }
    g.globalAlpha = 0.7; g.beginPath(); g.moveTo(X(-1), Y(0)); g.lineTo(X(1), Y(0)); g.moveTo(X(0), Y(-1)); g.lineTo(X(0), Y(1)); g.stroke();
    recent.forEach((p, i) => {
      const lastOne = i === recent.length - 1;
      g.globalAlpha = lastOne ? 1 : 0.25 + 0.6 * (i / recent.length);
      g.fillStyle = lastOne ? C.accent : C.ink;
      g.beginPath(); g.arc(X(p.x), Y(p.y), lastOne ? 5 : 3, 0, TAU); g.fill();
    });
    g.globalAlpha = 1;
  }

  function drawHist() {
    const { g, w, h } = H; g.clearRect(0, 0, w, h);
    const padX = 6, padB = 4, top = 6, span = w - padX * 2, bw = span / BINS;
    const max = Math.max(...bins, 1), scale = (h - padB - top) / (max * 1.1);
    const hiBin = lastU == null ? -1 : Math.floor((lastU - LO) / (HI - LO) * BINS);
    bins.forEach((c, i) => {
      g.globalAlpha = i === hiBin ? 1 : 0.8; g.fillStyle = i === hiBin ? C.accent : C.ink;
      const bh = c * scale; g.fillRect(padX + i * bw + 1, h - padB - bh, Math.max(1, bw - 2), bh);
    });
    // 기대 분포 N(0, σ²) — 점을 뽑을 때 쓴 σ. 쌓일수록 막대가 이 곡선에 가까워진다
    g.globalAlpha = 0.95; g.strokeStyle = C.accent; g.lineWidth = 1.5; g.beginPath();
    for (let k = 0; k <= 80; k++) {
      const u = LO + (HI - LO) * k / 80;
      const dens = Math.exp(-u * u / (2 * SIGMA * SIGMA)) / (SIGMA * Math.sqrt(TAU));
      const y = h - padB - dens * n * ((HI - LO) / BINS) * scale, x = padX + (u - LO) / (HI - LO) * span;
      if (k) g.lineTo(x, y); else g.moveTo(x, y);
    }
    g.stroke();
    g.globalAlpha = 0.8; g.strokeStyle = C.ink; g.lineWidth = 1; g.beginPath(); g.moveTo(padX, h - padB + 0.5); g.lineTo(w - padX, h - padB + 0.5); g.stroke();
    g.globalAlpha = 1;
  }

  function step(dt) {
    const prev = sweep; sweep = (sweep + dt * TAU / 4.5) % TAU; time += dt;
    targets.forEach(t => {
      const b = (Math.atan2(t.x, t.y) + TAU) % TAU;
      const passed = prev <= sweep ? (b > prev && b <= sweep) : (b > prev || b <= sweep);
      if (!passed) return;
      t.px = t.x; t.py = t.y; t.seen = time; pings.push({ x: t.x, y: t.y, t: time });
      lastU = record(t);
      Object.assign(t, randomPoint());   // 찾은 신호는 새 무작위 위치에서 다시 나타난다
    });
  }

  function draw() { if (!R.w) return; drawRadar(); drawScatter(); drawHist(); }

  const ro = new ResizeObserver(() => { [R, S, H].forEach(fit); draw(); });
  [R, S, H].forEach(v => ro.observe(v.c));

  let raf = 0, last = 0, visible = true;
  const frame = now => {
    raf = 0;
    if (!visible || document.hidden) { last = 0; return; }
    const dt = last ? Math.min(0.05, (now - last) / 1000) : 1 / 60; last = now;
    step(dt); draw(); raf = requestAnimationFrame(frame);
  };
  const wake = () => { if (!raf && !reduce) raf = requestAnimationFrame(frame); };
  new IntersectionObserver(es => { visible = es.some(e => e.isIntersecting); if (visible) wake(); }).observe(document.querySelector('.instrument'));
  document.addEventListener('visibilitychange', () => { last = 0; wake(); });
  [R, S, H].forEach(fit); draw(); wake();
})();


</script>
