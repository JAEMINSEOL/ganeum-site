---
import Base from '../../layouts/Base.astro';
import { PAGE_TITLES } from '../../site.config';
import ColumnList from '../../components/ColumnList.astro';
import { getColumns } from '../../lib';

const columns = await getColumns();
---
<Base title={PAGE_TITLES.columns} description="가늠의 데이터 분석 칼럼 전체 목록">
  <section class="wrap">
    <header class="page-head">
      <h1>분석 칼럼</h1>
      <p class="sub">분석 중 발생할 수 있는 함정, 용어 설명, 분석 기법을 소개합니다.</p>
    </header>
    <ColumnList columns={columns} />
  </section>
</Base>

<style>
  .page-head { padding: 64px 0 24px; border-bottom: 1px solid var(--rule); }
  h1 { font-weight: 700; font-size: var(--fs-h1); line-height: 1.18; margin: 4px 0 12px; letter-spacing: -0.025em; }
  .sub { margin: 0; color: var(--muted); max-width: 620px; word-break: keep-all; }
</style>
