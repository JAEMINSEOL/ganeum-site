---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib';

interface Props { columns: CollectionEntry<'columns'>[] }
const { columns } = Astro.props;
---
{columns.length === 0 ? (
  <p class="empty">첫 칼럼을 준비하고 있습니다.</p>
) : (
  <div>
    {columns.map((c) => (
      <a class="col-item" href={`/columns/${c.id}/`}>
        <div class="meta">
          <span>{formatDate(c.data.date)}</span>
          {c.data.draft && <span class="draft-badge">초안</span>}
        </div>
        <h3>{c.data.title}</h3>
        <p>{c.data.description}</p>
        {c.data.tags.length > 0 && (
          <div class="meta">{c.data.tags.map((t) => <span class="tag">{t}</span>)}</div>
        )}
      </a>
    ))}
  </div>
)}
