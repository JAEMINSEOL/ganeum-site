---
// 통계 용어 풀이 툴팁. 본문의 <a class="term" data-tip="풀이"> 또는 <span class="term" data-tip="풀이">에
// 마우스를 올리거나 키보드로 포커스하면 풀이를 띄운다. 터치 화면에서는 탭으로 열고 닫는다.
// 표(.table-scroll) 안에서도 잘리지 않도록 화면 기준(fixed)으로 띄운다.
---
<div id="term-tip" role="tooltip" hidden></div>

<script>
  const tip = document.getElementById('term-tip') as HTMLDivElement;
  let current: HTMLElement | null = null;

  function show(el: HTMLElement) {
    const text = el.dataset.tip;
    if (!text) return;
    current = el;
    tip.textContent = text;
    tip.hidden = false;
    const r = el.getBoundingClientRect();
    const w = Math.min(320, window.innerWidth - 32);
    tip.style.maxWidth = `${w}px`;
    const tw = tip.offsetWidth, th = tip.offsetHeight;
    let left = r.left + r.width / 2 - tw / 2;
    left = Math.max(16, Math.min(left, window.innerWidth - tw - 16));
    let top = r.top - th - 8;
    if (top < 8) top = r.bottom + 8;
    tip.style.left = `${left}px`;
    tip.style.top = `${top}px`;
    el.setAttribute('aria-describedby', 'term-tip');
  }
  function hide() {
    if (current) current.removeAttribute('aria-describedby');
    current = null;
    tip.hidden = true;
  }
  const termOf = (t: EventTarget | null) => (t instanceof Element ? t.closest<HTMLElement>('.term[data-tip]') : null);

  document.addEventListener('mouseover', (e) => { const el = termOf(e.target); if (el) show(el); });
  document.addEventListener('mouseout', (e) => { if (termOf(e.target)) hide(); });
  document.addEventListener('focusin', (e) => { const el = termOf(e.target); if (el) show(el); });
  document.addEventListener('focusout', (e) => { if (termOf(e.target)) hide(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') hide(); });
  window.addEventListener('scroll', hide, { passive: true });
  // 터치: 첫 탭은 풀이만 보여 주고 링크 이동은 막는다. 같은 용어를 다시 탭하면 닫는다.
  document.addEventListener('click', (e) => {
    const el = termOf(e.target);
    if (!el) { hide(); return; }
    if (window.matchMedia('(hover: none)').matches) {
      e.preventDefault();
      if (current === el) hide(); else show(el);
    }
  });
</script>

<style is:global>
  .prose .term[data-tip] {
    color: inherit;
    text-decoration: underline dotted;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    cursor: help;
  }
  .prose .term[data-tip]:focus-visible { outline: 2px solid var(--text); outline-offset: 2px; border-radius: 2px; }
  #term-tip {
    position: fixed;
    z-index: 50;
    padding: 10px 12px;
    background: var(--invert-bg);
    color: var(--invert-text);
    font-family: var(--sans);
    font-size: 13.5px;
    line-height: 1.55;
    border-radius: 6px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.18);
    pointer-events: none;
    word-break: keep-all;
  }
</style>
