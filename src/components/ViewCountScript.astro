---
import { GOATCOUNTER_CODE } from '../site.config';
const demo = import.meta.env.DEV && import.meta.env.PUBLIC_VIEWS_DEMO === '1';
---
{GOATCOUNTER_CODE && (
  <script is:inline data-goatcounter={`https://${GOATCOUNTER_CODE}.goatcounter.com/count`} async src="//gc.zgo.at/count.js"></script>
)}
{(GOATCOUNTER_CODE || demo) && (
  <script is:inline define:vars={{ code: GOATCOUNTER_CODE, demo }}>
    (function () {
      var els = document.querySelectorAll('.view-count[data-gc-path]');
      function show(el, text) { el.textContent = '조회 ' + text; el.hidden = false; }
      els.forEach(function (el, i) {
        var path = el.getAttribute('data-gc-path');
        if (demo) { show(el, (1234 * (i + 1)).toLocaleString('ko-KR')); return; }
        fetch('https://' + code + '.goatcounter.com/counter/' + encodeURIComponent(path) + '.json')
          .then(function (r) {
            if (r.status === 404) return { count: '0' }; // 아직 집계된 조회가 없는 경로
            if (!r.ok) throw new Error(String(r.status));
            return r.json();
          })
          .then(function (d) { if (d && d.count != null) show(el, d.count); })
          .catch(function () { /* 조용히 숨김 유지 */ });
      });
    })();
  </script>
)}
