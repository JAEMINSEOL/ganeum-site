---
import 'wanted-sans/fonts/webfonts/variable/split/WantedSansVariable.css';
import '../styles/global.css';
import ViewCountScript from '../components/ViewCountScript.astro';
import { SITE_TITLE } from '../site.config';

interface Props {
  title?: string;
  description?: string;
}
const { title, description = '데이터를 가늠하는 분석 칼럼. 숫자를 제대로 읽는 법을 씁니다. 분석 의뢰는 상담과 견적 무료, 1만 원부터.' } = Astro.props;
const ogImage = new URL('/og.png', Astro.site);
const fullTitle = title ? `${title} | 가늠` : SITE_TITLE;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="가늠" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="가늠: 숫자를 제대로 가늠하는 법. 데이터 분석 칼럼과 분석 의뢰, 상담과 견적 무료" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="wordmark" href="/" aria-label="가늠">
          <img class="wordmark-img wordmark-img--on-light" src="/brand/wordmark-B2d-on-light.svg" alt="" width="2516" height="1000" />
          <img class="wordmark-img wordmark-img--on-dark" src="/brand/wordmark-B2d-on-dark.svg" alt="" width="2516" height="1000" />
        </a>
        <nav class="nav" aria-label="주요 메뉴">
          <a href="/request/">분석 의뢰</a>
          <a href="/#ai">AI 분석</a>
          <a href="/columns/">칼럼</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <span>© {new Date().getFullYear()} 가늠, data-ganeum.com</span>
        <address class="biz">
          <span>상호 가늠</span><span>대표자 설재민</span><span>사업자등록번호 154-71-00762</span>
          <span>사업장 주소 경기도 군포시 송부로34번길 9-12</span><span>전화 070-4519-8630</span><span>문의 bara0228.dev@gmail.com</span>
        </address>
        <nav>
          <a href="/columns/">칼럼</a>
          <a href="/about/">소개</a>
          <a href="/terms/">이용약관</a>
          <a href="/privacy/"><strong>개인정보처리방침</strong></a>
          <a href="/refund/">환불정책</a>
          <a href="/pricing/">티켓 상품 안내</a>
        </nav>
      </div>
    </footer>
    <ViewCountScript />
    <script is:inline>
      // 빌드 단계에서 괄호와 조사 사이에 넣은 보이지 않는 연결 문자(U+2060)를 복사할 때 지운다
      document.addEventListener('copy', function (e) {
        var sel = window.getSelection();
        if (!sel || sel.isCollapsed || !e.clipboardData) return;
        var wj = new RegExp(String.fromCharCode(0x2060), 'g');
        var text = sel.toString();
        if (!wj.test(text)) return;
        var box = document.createElement('div');
        for (var i = 0; i < sel.rangeCount; i++) box.appendChild(sel.getRangeAt(i).cloneContents());
        e.clipboardData.setData('text/plain', text.replace(wj, ''));
        e.clipboardData.setData('text/html', box.innerHTML.replace(wj, ''));
        e.preventDefault();
      });
    </script>
  </body>
</html>
